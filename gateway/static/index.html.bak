<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ULTRON — Assistente AI</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤖</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/ui/vendor/katex.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
  <link rel="stylesheet" href="/ui/style.css">
  <link rel="stylesheet" href="/ui/ultron_ui.css">
  <script src="/ui/vendor/marked.min.js"></script>
  <script src="/ui/vendor/katex.min.js"></script>
  <script src="/ui/vendor/auto-render.min.js"></script>
  <script src="/ui/vendor/mermaid.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
  <style>
    /* Nasconde il menu dei profili (Doc, Avv, ecc.) ma lascia il codice per non far crashare app.js */
    .prof-picker { display: none !important; }
  </style>
</head>
<body>
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>

  <div id="onboarding" class="onboarding" style="display: none;">
    <div class="onb-card">
      <div class="onb-logo">🤖</div>
      <h1 class="onb-title">Benvenuto in ULTRON</h1>
      <p class="onb-sub">Il tuo assistente AI personale. Configurazione in 10 secondi.</p>
      <form id="onboarding-form">
        <label class="onb-label">Come ti chiami?</label>
        <input type="text" id="onb-name" class="onb-input" placeholder="Il tuo nome" autocomplete="off" required>
        <label class="onb-label">Che lavoro fai?</label>
        <div id="prof-grid" class="prof-grid"></div>
        <button type="submit" class="onb-start">Inizia →</button>
      </form>
    </div>
  </div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <div class="logo">
        <div class="logo-mark">🤖</div>
        <div class="logo-text">
          <span class="logo-name">ULTRON</span>
          <span class="logo-version">v1.0</span>
        </div>
      </div>
      <button class="icon-btn" id="toggle-sidebar" title="Chiudi">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
    </div>
    <button class="new-chat-btn" id="new-chat">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span>Nuova chat</span>
    </button>
    <div class="search-wrap">
      <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="text" id="search-conv" class="search-input" placeholder="Cerca conversazioni...">
    </div>
    <div class="conv-section-title">Recenti</div>
    <div class="conversations" id="conversations"></div>
    <button class="clear-all-btn" id="clear-all-btn" title="Elimina tutte le conversazioni">🗑️ Elimina tutti i recenti</button>
    <div class="credits-panel">
      <div class="credits-title">Stato sistema</div>
      <div class="credits-list" id="credits-list"></div>
    </div>
    <div class="sidebar-footer">
      <div class="status-pill" id="status-pill">
        <span class="status-dot"></span>
        <span id="status-text">Connessione...</span>
      </div>
    </div>
  </aside>

  <main class="main with-sidebar">
    <header class="topbar">
      <button class="icon-btn menu-btn" id="menu-btn" title="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="prof-picker">
        <button class="prof-btn" id="prof-btn"><span id="prof-icon" class="prof-icon">🤖</span><span id="prof-name" class="prof-name">ULTRON</span></button>
        <div class="prof-dropdown" id="prof-dropdown"></div>
      </div>
      <div class="topbar-spacer"></div>
      <div class="topbar-actions">
        <button class="action-btn" id="calendar-btn" title="Calendario">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </button>
        <button class="action-btn" id="orchestrator-btn" title="NEXUS">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m7.08 7.08l4.24 4.24M1 12h6m6 0h6M4.22 19.78l4.24-4.24m7.08-7.08l4.24-4.24"/></svg>
        </button>
        <button class="action-btn" id="image-btn" title="Genera immagine">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </button>
        <button class="voice-toggle" id="voice-toggle" title="Attiva voce">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
          <span class="voice-label">Voce</span>
        </button>
      </div>
    </header>

    <div class="messages" id="messages"></div>
    <div class="voice-status" id="voice-status"></div>

    <div class="composer-wrap">
      <form class="composer" id="composer">
        <button type="button" class="composer-btn attach" id="attach-btn" title="Allega file" onclick="document.getElementById('file-input').click()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
        </button>
        <input type="file" id="file-input" style="display: none;" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.md,.csv,.json,image/*" onchange="window.handleFileUpload(this)">
        <textarea id="input" placeholder="Scrivi un messaggio a ULTRON..." rows="1"></textarea>
        <button type="submit" class="composer-btn send" id="send" title="Invia">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
        </button>
      </form>
      <div class="composer-hint">ULTRON può commettere errori · Verifica le informazioni importanti</div>
    </div>
  </main>

  <!-- MODALI -->
  <div id="orchestrator-modal" class="orch-modal">
    <div class="orch-panel">
      <div class="orch-header"><h2>NEXUS (Orchestratore)</h2><button class="icon-btn" id="orch-close">✕</button></div>
      <div class="orch-body">
        <div class="orch-form">
          <label>Cartella progetto</label><input type="text" id="orch-project-dir" value="/Users/jabo86/sinfonia/workspaces/progetto">
          <label>Linguaggio</label>
          <select id="orch-language" class="orch-select">
            <option value="python">Python</option><option value="rust">Rust</option><option value="javascript">JavaScript</option><option value="typescript">TypeScript</option><option value="go">Go</option><option value="c">C</option><option value="cpp">C++</option><option value="java">Java</option>
          </select>
          <label>Modello Ollama</label><input type="text" id="orch-model" value="qwen2.5-coder:7b-32k">
          <label>REQUIREMENTS.md</label><textarea id="orch-requirements" placeholder="Descrivi cosa deve fare il progetto..."></textarea>
          <label class="orch-checkbox"><input type="checkbox" id="orch-clean"> Cancella cartella esistente</label>
          <div class="orch-actions"><button id="orch-start" class="orch-btn primary">▶ Avvia</button><button id="orch-stop" class="orch-btn danger" disabled>⏹ Ferma</button></div>
        </div>
        <div class="orch-status">
          <div class="orch-row"><span>Fase</span><span id="orch-phase" class="badge idle">idle</span></div>
          <div class="orch-row"><span>Linguaggio</span><span id="orch-status-lang">—</span></div>
          <div class="orch-row"><span>Modello</span><span id="orch-status-model">—</span></div>
          <div class="orch-row"><span>Verdict</span><span id="orch-status-verdict">—</span></div>
          <div class="orch-log" id="orch-log">In attesa...</div>
        </div>
        <div class="orch-files"><h3>File prodotti</h3><div id="orch-file-list" class="orch-file-list"><em>Nessun file ancora.</em></div></div>
      </div>
    </div>
  </div>

  <div id="image-modal" class="orch-modal">
    <div class="orch-panel" style="max-width: 720px;">
      <div class="orch-header"><h2>🎨 Genera immagine</h2><button class="icon-btn" id="image-close">✕</button></div>
      <div class="orch-body" style="grid-template-columns: 1fr;">
        <div class="orch-form">
          <label>Prompt</label><textarea id="image-prompt" placeholder="Es: un gatto astronauta su Marte" style="min-height: 80px;"></textarea>
          <div class="orch-actions"><button id="image-generate" class="orch-btn primary">Genera</button></div>
          <div id="image-result" style="margin-top: 16px; display: none;">
            <div class="orch-preview-title" id="image-result-title"></div>
            <div style="padding: 12px; background: #0a0a12; text-align: center;"><img id="image-result-img" style="max-width: 100%; border-radius: 8px;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="calendar-modal" class="orch-modal">
    <div class="orch-panel" style="max-width: 800px;">
      <div class="orch-header"><h2>📅 Calendario</h2><button class="icon-btn" id="cal-close">✕</button></div>
      <div class="orch-body" style="grid-template-columns: 1fr;">
        <div>
          <div class="cal-header-nav"><button id="cal-prev" class="cal-nav-btn">◀</button><div id="cal-month-title" class="cal-month-title"></div><button id="cal-next" class="cal-nav-btn">▶</button></div>
          <div id="cal-grid" class="cal-grid"></div>
        </div>
        <div style="margin-top: 15px; padding: 15px; background: #161622; border: 1px solid #2a2a3e; border-radius: 8px;">
          <h3 id="cal-day-title" style="margin: 0 0 10px; font-size: 14px; color: #a78bfa;">Seleziona un giorno</h3>
          <div id="cal-day-list"></div>
        </div>
        <div style="margin-top: 15px; padding: 15px; background: #161622; border: 1px solid #ffaa00; border-radius: 8px;">
          <h3 style="margin: 0 0 10px 0; font-size: 14px; color: #ffaa00;">⏰ Le tue Sveglie</h3>
          <div id="cal-alarm-list"><em style="color: #6b6b80; font-size: 13px;">Caricamento...</em></div>
        </div>
      </div>
    </div>
  </div>

  <div id="toast-container" class="toast-container"></div>

  <script src="/ui/profile.js"></script>
  <script src="/ui/onboarding.js"></script>
  <script src="/ui/media_interceptor.js"></script>
  <script src="/ui/app.js"></script>
    <script src="/ui/calendar_interceptor.js"></script>
  <script src="/ui/calendar_ui.js"></script>
  <script src="/ui/orchestrator_ui.js"></script>
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="/ui/ultron_core.js"></script>
  <script src="/ui/force_ultron.js"></script>
</body>
</html>
