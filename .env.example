# Sinfonia — Template variabili d'ambiente
# Copia questo file in .env e riempi con le TUE chiavi.

# --- Provider gratuiti ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_TOKEN=
NVIDIA_API_KEY=

# --- Provider a pagamento (opzionali) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Configurazione locale ---
OLLAMA_BASE_URL=http://localhost:11434
SINFONIA_DB_PATH=./data/sinfonia.db
SINFONIA_LOG_LEVEL=INFO
